# Postgres 연결 문자열 (Render Postgres의 "Internal Database URL" 또는 "External Database URL")
DATABASE_URL=postgres://user:password@host:5432/dbname

# 앱 접속 비밀번호
APP_PASSWORD=change-me

# 쿠키 서명에 쓰는 임의의 긴 문자열 (아무 무작위 문자열이면 됩니다)
SESSION_SECRET=change-me-too

# 로컬 개발용 포트 (Render는 자동으로 PORT를 주입합니다)
PORT=3000
